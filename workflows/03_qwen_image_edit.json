{
  "_comment": "Qwen-Image-Edit 2509. Instruction-driven editing, up to 3 reference images. No Lightning LoRA installed for the EDIT model, so this runs 20 steps / CFG 4.0. If you add Qwen-Image-Edit-2509-Lightning-4steps, drop to steps=4 cfg=1.0 and insert a LoraLoaderModelOnly between node 1 and node 5.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "qwen_image_edit_2509_fp8_e4m3fn.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "qwen_image_vae.safetensors" } },
  "5": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.0 } },
  "6": { "class_type": "CFGNorm", "inputs": { "model": ["5", 0], "strength": 1.0 } },

  "7": { "class_type": "LoadImage", "inputs": { "image": "claude_start_frame.png", "upload": "image" } },
  "8": { "class_type": "FluxKontextImageScale", "inputs": { "image": ["7", 0] } },

  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "image1": ["8", 0],
      "prompt": "Change the scene to deep winter: the rocks and the lighthouse are coated in thick snow and ice, the sea is slate grey with drifting ice floes, the sky is a pale overcast white. Keep the lighthouse architecture, camera angle and composition exactly the same."
    }
  },
  "11": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": { "clip": ["2", 0], "vae": ["3", 0], "image1": ["8", 0], "prompt": "" }
  },
  "12": { "class_type": "VAEEncode", "inputs": { "pixels": ["8", 0], "vae": ["3", 0] } },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0], "seed": 99, "steps": 20, "cfg": 4.0,
      "sampler_name": "euler", "scheduler": "simple",
      "positive": ["10", 0], "negative": ["11", 0], "latent_image": ["12", 0], "denoise": 1.0
    }
  },
  "14": { "class_type": "VAEDecode", "inputs": { "samples": ["13", 0], "vae": ["3", 0] } },
  "15": {
    "class_type": "SaveImage",
    "inputs": { "images": ["14", 0], "filename_prefix": "claude-generated/qwen_edit" }
  }
}
