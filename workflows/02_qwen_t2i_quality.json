  "12": { "class_type": "EmptySD3LatentImage", "inputs": { "width": 1328, "height": 1328, "batch_size": 1 } },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0], "seed": 7, "steps": 20, "cfg": 2.5,
