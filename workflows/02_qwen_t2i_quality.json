      "positive": ["10", 0], "negative": ["11", 0], "latent_image": ["12", 0], "denoise": 1.0
    }
  },
  "14": { "class_type": "VAEDecode", "inputs": { "samples": ["13", 0], "vae": ["3", 0] } },
  "15": {
    "class_type": "SaveImage",
    "inputs": { "images": ["14", 0], "filename_prefix": "claude-generated/qwen_quality" }
