    "12",
    0
   ],
   "attn_mask": [
    "23",
    0
   ],
   "weight": 0.6,
   "weight_type": "linear",
   "combine_embeds": "concat",
   "start_at": 0.0,
   "end_at": 1.0,
   "embeds_scaling": "V only"
  }
 },
