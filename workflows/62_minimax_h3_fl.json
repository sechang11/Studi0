{
  "_comment": "MiniMax H3 first-AND-last frame to video+audio. Identical to workflow 60 except node 9 supplies last_frame, which the fl2va checkpoint has always supported and which nothing was ever connected to. Pinning both ends is what stops a segment wandering off its scene, so a run of these can be joined into a long shot that keeps its place AND keeps H3's native stereo - which the Wan context-window route cannot do. Node 8 is the first frame, node 9 the last; length must be 17n+5.",
  "_notes": [
    "length must be 17n+5. 124 = ~5.2s, 361 = ~15s. See h3_length() in the builder.",
    "the 4-step turbo LoRA on node 5 replaces the template's 20-step schedule.",
    "sampler is res_multistep; the template's own choice, do not swap it blind.",
    "audio comes out of node 41 and is muxed by CreateVideo - there is no separate score to lay under this one.",
    "do NOT call set_negative() on this graph; there is no negative input."
  ],
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "6": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "5",
        0
      ],
      "shift_video": 5.0,
      "shift_audio": 5.0
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "h3_start.png",
      "upload": "image"
    }
  },
  "20": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "first_frame": [
        "8",
        0
      ],
      "prompt": "A scene with natural motion.",
      "width": 768,
      "height": 1344,
      "length": 124,
      "last_frame": [
        "9",
        0
      ]
    }
  },
  "30": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "6",
        0
      ],
      "conditioning": [
        "20",
        0
      ]
    }
  },
  "31": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "32": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "6",
        0
      ],
      "scheduler": "simple",
      "steps": 4,
      "denoise": 1.0
    }
  },
  "33": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 4200
    }
  },
  "35": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "33",
        0
      ],
      "guider": [
        "30",
        0
      ],
      "sampler": [
        "31",
        0
      ],
      "sigmas": [
        "32",
        0
      ],
      "latent_image": [
        "20",
        1
      ]
    }
  },
  "40": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "35",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "41": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "35",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "50": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "40",
        0
      ],
      "audio": [
        "41",
        0
      ],
      "fps": 24.0,
      "bit_depth": 8
    }
  },
  "51": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "50",
        0
      ],
      "filename_prefix": "claude-generated/h3_fl",
      "format": "auto",
      "codec": "h264"
    }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "h3_end.png",
      "upload": "image"
    }
  }
}