{
 "_comment": [
  "78 Krea 2 Turbo with the official STYLE REFERENCE LoRA: one picture sets the look, the",
  "prompt sets the subject. The template pairs the LoRA with krea2_turbo_int8_convrot; this",
  "graph uses the fp8_scaled Turbo already on disk (same weights, other quantisation).",
  "Knobs: 20 style image (in ComfyUI/input), 6 prompt, 9 width/height, 13 seed, 12 prefix.",
  "Chain as shipped: TextEncodeQwenImageEditPlus(image1) -> FluxKontextMultiReferenceLatentMethod",
  "(index_timestep_zero) -> CFGGuider cfg 1 -> SamplerCustomAdvanced euler/simple 8 steps,",
  "ModelSamplingFlux max_shift 1.15 base_shift 0.5, LoRA strength 1.0."
 ],
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "krea2_turbo_fp8_scaled.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
   "type": "krea2",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  }
 },
 "4": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "lora_name": "krea2_style_reference.safetensors",
   "strength_model": 1.0,
   "model": [
    "1",
    0
   ]
  }
 },
 "5": {
  "class_type": "ModelSamplingFlux",
  "inputs": {
   "max_shift": 1.15,
   "base_shift": 0.5,
   "width": 1280,
   "height": 704,
   "model": [
    "4",
    0
   ]
  }
 },
 "20": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "krea2_style_ref.png"
  }
 },
 "6": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "prompt": "A man in a worn canvas coat stands at the edge of the frame, looking off.",
   "clip": [
    "2",
    0
   ],
   "image1": [
    "20",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "7": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "reference_latents_method": "index_timestep_zero",
   "conditioning": [
    "6",
    0
   ]
  }
 },
 "8": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "7",
    0
   ]
  }
 },
 "9": {
  "class_type": "EmptyLatentImage",
  "inputs": {
   "width": 1280,
   "height": 704,
   "batch_size": 1
  }
 },
 "13": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 4242
  }
 },
 "14": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  }
 },
 "15": {
  "class_type": "BasicScheduler",
  "inputs": {
   "scheduler": "simple",
   "steps": 8,
   "denoise": 1.0,
   "model": [
    "5",
    0
   ]
  }
 },
 "16": {
  "class_type": "CFGGuider",
  "inputs": {
   "cfg": 1.0,
   "model": [
    "5",
    0
   ],
   "positive": [
    "7",
    0
   ],
   "negative": [
    "8",
    0
   ]
  }
 },
 "17": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "13",
    0
   ],
   "guider": [
    "16",
    0
   ],
   "sampler": [
    "14",
    0
   ],
   "sigmas": [
    "15",
    0
   ],
   "latent_image": [
    "9",
    0
   ]
  }
 },
 "11": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "17",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "12": {
  "class_type": "SaveImage",
  "inputs": {
   "filename_prefix": "claude-generated/krea2/style",
   "images": [
    "11",
    0
   ]
  }
 }
}