{
  "_comment": "ACE-Step 1.5 Turbo: text -> music. Put genre/instrumentation/mood in `tags`, leave `lyrics` empty for an instrumental (or write [verse]/[chorus] blocks for a song). `duration` on node 10 and `seconds` on node 11 should match. generate_audio_codes=true runs the LLM front-end: slower but noticeably better structure - turn it off for quick drafts.",

  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "acestep_v1.5_turbo.safetensors", "weight_dtype": "default" } },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "qwen_0.6b_ace15.safetensors",
      "clip_name2": "qwen_1.7b_ace15.safetensors",
      "type": "ace",
      "device": "default"
    }
  },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ace_1.5_vae.safetensors" } },

  "10": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "inputs": {
      "clip": ["2", 0],
      "tags": "cinematic orchestral score, low sustained strings, sparse solo piano, distant swelling brass, subtle analogue tape hiss, melancholic, patient, slow build to a single restrained climax, no drums, no percussion, film soundtrack",
      "lyrics": "",
      "seed": 77,
      "bpm": 64,
      "duration": 60.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "D minor",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "11": { "class_type": "EmptyAceStep1.5LatentAudio", "inputs": { "seconds": 60.0, "batch_size": 1 } },

  "12": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 77,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["10", 0],
      "negative": ["10", 0],
      "latent_image": ["11", 0],
      "denoise": 1.0
    }
  },
  "13": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["12", 0], "vae": ["3", 0] } },
  "14": {
    "class_type": "SaveAudioMP3",
    "inputs": { "audio": ["13", 0], "filename_prefix": "claude-generated/score", "quality": "320k" }
  }
}
