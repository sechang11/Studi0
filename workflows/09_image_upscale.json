{
  "_comment": "4x GAN upscale for stills. 1664x928 -> 6656x3712. Safe on a single image; see the warning in 07 before pointing this at a video frame batch.",

  "1": { "class_type": "LoadImage", "inputs": { "image": "claude_start_frame.png", "upload": "image" } },
  "2": { "class_type": "UpscaleModelLoader", "inputs": { "model_name": "RealESRGAN_x4plus.safetensors" } },
  "3": { "class_type": "ImageUpscaleWithModel", "inputs": { "upscale_model": ["2", 0], "image": ["1", 0] } },
  "4": {
    "class_type": "SaveImage",
    "inputs": { "images": ["3", 0], "filename_prefix": "claude-generated/upscaled_4x" }
  }
}
