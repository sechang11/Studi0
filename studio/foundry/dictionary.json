 "style": {
  "main": true,
  "label": "Style (the film's look)",
  "spectrum": [
   "photoreal",
   "cinematic",
   "semi-realistic",
   "noir",
   "watercolour",
   "anime",
   "cartoon",
   "claymation",
   "pixel"
  ],
  "options": {
   "photoreal": {
    "label": "Photoreal",
    "spectrum": 0,
    "look_clause": "photoreal, natural light, high detail, colour photograph, sharp focus",
    "defense": "",
    "kf_engine": "qwen",
    "neg": "cartoon, anime, illustration, painting, cgi, 3d render"
   },
   "cinematic": {
    "label": "Cinematic film",
    "spectrum": 1,
    "look_clause": "cinematic film still, 35mm, shallow depth of field, filmic grade, high detail, colour photograph",
    "defense": "",
    "kf_engine": "qwen",
    "neg": "cartoon, anime, illustration, cgi, 3d render, flat lighting"
   },
   "noir": {
    "label": "Film noir",
    "spectrum": 2,
    "look_clause": "1940s black and white film noir, hard shadows, heavy film grain, deep blacks, high contrast",
    "defense": "The whole shot stays black and white film noir throughout",
    "kf_engine": "qwen",
    "neg": "colour, cartoon, anime, cgi, flat lighting"
   },
   "watercolour": {
    "label": "Watercolour",
    "spectrum": 3,
    "look_clause": "loose watercolour painting on rough cotton paper, visible pigment blooms, white paper showing through",
    "defense": "The whole shot stays a loose watercolour painting throughout",
    "kf_engine": "qwen",
    "neg": "photorealistic, photograph, 3d render, hard outlines"
   },
   "anime": {
    "label": "Anime (cel)",
    "spectrum": 4,
    "look_clause": "flat cel-shaded hand-drawn 2D anime with clean line art and painted background art",
    "defense": "The whole scene stays flat cel-shaded hand-drawn 2D anime with clean line art throughout",
    "kf_engine": "animagine",
    "neg": "photorealistic, photograph, live action, 3d render, realistic skin"
   },
   "cartoon": {
    "label": "Cartoon (flat)",
    "spectrum": 5,
    "look_clause": "bold flat 2D cartoon, thick clean outlines, simple saturated colour fills, minimal shading",
    "defense": "The whole shot stays a bold flat 2D cartoon with thick outlines throughout",
    "kf_engine": "qwen",
    "neg": "photorealistic, photograph, detailed rendering, realistic shading"
   },
   "claymation": {
    "label": "Claymation",
    "spectrum": 6,
    "look_clause": "stop-motion clay animation, visible fingerprints in the plasticine, handmade miniature set, film grain",
    "defense": "The whole shot stays stop-motion clay animation throughout",
    "kf_engine": "qwen",
    "neg": "photorealistic skin, smooth cgi, anime"
   },
   "pixel": {
    "label": "Pixel art",
    "spectrum": 7,
    "look_clause": "16-bit pixel art, chunky visible square pixels, limited palette, hard dithering, no antialiasing",
    "defense": "The whole shot stays 16-bit pixel art with hard visible pixels throughout",
    "kf_engine": "qwen",
    "neg": "smooth gradients, photorealistic, antialiasing"
   },
   "semi-realistic": {
    "label": "Semi-realistic caricature",
    "spectrum": 2,
    "look_clause": "semi-realistic 3D caricature, exaggerated cartoon proportions with an oversized head and small body, but rendered with photoreal skin texture, real fabric weave and physically accurate lighting, in the manner of a high-end character render composited into live-action photography, soft key light, shallow depth of field",
    "defense": "",
    "kf_engine": "qwen",
    "neg": "flat 2d, line art, cel shading, anime, sketch, painterly, low detail, plastic toy, uncanny dead eyes"
   }
  }
 },
